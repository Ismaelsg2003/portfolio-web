---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import DemoVideo from "../components/DemoVideo.astro";
import Avatar from "../components/Avatar.astro";
import { profile, about, facts, services, experience, education, skills } from "../data/profile";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const featured = projects.find((p) => p.data.featured)!;
const others = projects.filter((p) => p !== featured);
const statusLabel = { terminado: "Terminado", "en-desarrollo": "En desarrollo", proximamente: "Próximamente" };
---
<Base>
  <section class="hero" id="sobre-mi">
    <div class="wrap hero-grid">
      <div class="portrait" data-parallax="0.12">
        <div class="enter e1"><Avatar size={390} /></div>
      </div>
      <div class="intro">
        <div class="head">
          <h1 class="enter e2 fit-name">{profile.name}</h1>
          <p class="role enter e3">
            <span>Desarrollador Python especializado en</span>
            <span class="sr-only">backend, automatización, inteligencia artificial y datos</span>
            <span class="rotator" aria-hidden="true">
              <span class="rot-word" aria-hidden="true">backend y APIs</span>
            </span>
          </p>
        </div>
        <div class="body">
        <div class="about enter e4">
          {about.map((para) => <p class="justify">{para}</p>)}
        </div>
        <dl class="facts enter e5">
          {facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
        </dl>
        <div class="actions enter e6">
          <a class="btn btn-primary" href="#proyectos">Ver proyectos</a>
          <a class="btn btn-line" href={profile.cv} download>Descargar CV<span class="sr-only"> (PDF)</span></a>
        </div>
        </div>
      </div>
    </div>
  </section>

  <section class="what" aria-labelledby="what-h">
    <div class="wrap">
      <div class="section-head" data-reveal><h2 id="what-h">Qué hago</h2></div>
      <div class="what-grid">
        {services.map((sv) => (
          <article class="what-card" data-reveal>
            <h3>{sv.title}</h3>
            <p class="justify">{sv.text}</p>
            <ul class="chips">{sv.tags.map((tg) => <li>{tg}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="proyectos">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2>Proyectos</h2>
      </div>

      <article class="featured" data-reveal data-scrub="enter">
        <div class="f-body">
          <div class="f-meta"><span class="status terminado">{statusLabel[featured.data.status]}</span><span>{featured.data.area}</span></div>
          <h3><a class="card-link" href={`/proyectos/${featured.id}/`}>{featured.data.title}</a></h3>
          <p class="justify">{featured.data.summary}</p>
          <dl class="metrics">
            {featured.data.metrics.map((m) => (
              <div><dt data-count>{m.value}</dt><dd>{m.label}</dd></div>
            ))}
          </dl>
          <ul class="chips">{featured.data.stack.map((s) => <li>{s}</li>)}</ul>
          <div class="actions">
            <a class="btn btn-primary" href={`/proyectos/${featured.id}/`}>Cómo funciona</a>
            {featured.data.repo && <a class="btn btn-line" href={featured.data.repo}>Código en GitHub</a>}
          </div>
        </div>
        <figure class="screen">
          <DemoVideo src={featured.data.video!} poster={featured.data.poster!} label="Demo del bot RPA para empresas de grúas" />
          <figcaption>Demo con datos ficticios: el bot acepta servicios y asigna grúas mientras el gerente lo supervisa.</figcaption>
        </figure>
      </article>

      <div class="grid">
        {others.map((p) => <ProjectCard project={p} statusLabel={statusLabel[p.data.status]} />)}
      </div>
    </div>
  </section>

  <section id="experiencia" class="band">
    <div class="wrap">
      <div class="section-head" data-reveal><h2>Experiencia</h2></div>
      <ol class="timeline" data-scrub="through">
        {experience.map((e) => (
          <li data-reveal data-scrub="mark">
            <div class="when">{e.period}</div>
            <div>
              <h3>{e.role}</h3>
              <p class="where">{e.company}{e.sector && `, ${e.sector.toLowerCase()}`}</p>
              <ul class="points">{e.points.map((pt) => <li class="justify">{pt}</li>)}</ul>
              {e.stack.length > 0 && <ul class="chips">{e.stack.map((s) => <li>{s}</li>)}</ul>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="formacion">
    <div class="wrap two-col">
      <div>
        <div class="section-head" data-reveal><h2>Formación</h2></div>
        <ul class="edu">
          {education.map((ed) => (
            <li class={ed.main ? "main" : "minor"} data-reveal>
              <h3>{ed.title}</h3>
              <p>{ed.place}</p>
              <span>{ed.period}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <div class="section-head" data-reveal><h2>Stack</h2></div>
        <div class="skills">
          {skills.map((g) => (
            <div data-reveal><h3>{g.group}</h3><ul class="chips">{g.items.map((s) => <li>{s}</li>)}</ul></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="contacto" class="contact">
    <div class="wrap">
      <h2 data-reveal>¿Hablamos?</h2>
      <p>Busco un puesto o proyectos como desarrollador Python: backend, automatización, datos e inteligencia artificial.</p>
      <a class="mail" data-reveal href={`mailto:${profile.email}`}>{profile.email}</a>
      <div class="actions">
        <a class="btn btn-line" href={profile.linkedin}>LinkedIn</a>
        <a class="btn btn-line" href={profile.github}>GitHub</a>
        <a class="btn btn-line" href={profile.cv} download>Descargar CV<span class="sr-only"> (PDF)</span></a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Name on a single line, as large as fits the column (max 64px). If even the minimum
  // readable size doesn't fit (phones), let it wrap onto two lines.
  const h1 = document.querySelector<HTMLElement>(".fit-name");
  const fit = () => {
    if (!h1) return;
    const shortScreen = window.innerHeight < 880 && window.innerWidth > 960;
    const narrow = window.innerWidth <= 960;
    const max = shortScreen ? 54 : narrow ? 56 : 64, min = narrow ? 26 : 34;
    h1.style.whiteSpace = "nowrap";
    h1.style.fontSize = max + "px";
    const avail = h1.parentElement!.clientWidth;
    const size = Math.floor(max * Math.min(1, avail / h1.scrollWidth) * 0.99);
    if (size >= min) { h1.style.fontSize = size + "px"; }
    else { h1.style.whiteSpace = ""; h1.style.fontSize = ""; }
  };
  fit();
  document.fonts?.ready.then(fit);
  window.addEventListener("resize", fit);
</script>

<style>
  .hero { padding: 72px 0 64px; overflow: clip; }
  /* On desktop the landing fills the first screen and sits in the middle of it */
  @media (min-width: 961px) {
    .hero { min-height: calc(100svh - 65px); display: grid; align-content: center; padding: 32px 0; }
    /* the name always fits on one line: its size follows the width of its column */
    .intro { container-type: inline-size; }
    .hero h1 { font-size: clamp(32px, 8cqi, 66px); white-space: nowrap; }
  }
  /* Laptops with short screens (1366×768, 1280×720…): tighten the landing so it fits */
  @media (min-width: 961px) and (max-height: 880px) {
    .hero { padding: 20px 0; }
    .hero h1 { font-size: clamp(32px, 7.6cqi, 56px); }
    .hero .role { margin-top: 10px; font-size: 17px; }
    .about { margin-top: 14px; gap: 8px; font-size: 15.5px; line-height: 1.55; }
    .facts { margin-top: 16px; gap: 10px 24px; }
    .facts dd { font-size: 15px; }
    .hero .actions { margin-top: 18px; }
    .portrait :global(.avatar) { width: min(100%, 330px) !important; }
  }
  @media (min-width: 961px) and (max-height: 740px) {
    .about { font-size: 15px; line-height: 1.5; }
    .hero h1 { font-size: clamp(30px, 7cqi, 50px); }
    .portrait :global(.avatar) { width: min(100%, 290px) !important; }
  }
  .hero-grid { display: grid; grid-template-columns: clamp(260px, 31vw, 410px) minmax(0, 1fr); gap: clamp(32px, 4.5vw, 60px); align-items: center; }
  .portrait :global(.avatar) { width: min(100%, 390px) !important; height: auto !important; aspect-ratio: 1; }
  .portrait { display: grid; justify-items: center; }
  h1 { font-size: clamp(40px, 5.2vw, 64px); font-weight: 800; letter-spacing: -0.035em; line-height: 1.02; }
  .role { margin-top: 14px; font-weight: 600; color: var(--navy); font-size: 19px; display: flex; flex-wrap: wrap; gap: 0 .35em; }
  .rotator { position: relative; display: inline-block; color: var(--ink); }
  .rotator::after { content: ""; position: absolute; left: 0; right: 0; bottom: -3px; height: 3px; border-radius: 2px; background: var(--amber); transform-origin: left; animation: underline 3s ease-in-out infinite; }
  .rested .rotator::after { animation: none; transform: scaleX(1); }
  .rot-word { display: inline-block; }
  .rot-word.out { animation: word-out .35s ease-in forwards; }
  .rot-word.in { animation: word-in .45s cubic-bezier(.2, .9, .3, 1.2) forwards; }
  .about { margin-top: 22px; display: grid; gap: 12px; color: var(--muted); max-width: 64ch; }
  .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 28px; margin: 26px 0 0; max-width: 64ch; }
  .facts div { border-left: 3px solid var(--amber); padding-left: 12px; }
  .facts dt { font-size: 13px; color: var(--muted); font-weight: 600; }
  .facts dd { margin: 2px 0 0; font-weight: 600; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }

  @keyframes word-out { to { opacity: 0; transform: translateY(-60%); } }
  @keyframes word-in { from { opacity: 0; transform: translateY(60%); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .rot-word.out { animation: fade-out .3s ease forwards; }
    .rot-word.in { animation: fade-in .4s ease forwards; }
    .rotator::after { animation: none; }
    .enter { animation-name: fade-in; animation-duration: .6s; }
  }
  @keyframes fade-out { to { opacity: 0; } }
  @keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes underline { 0% { transform: scaleX(0); } 20%, 80% { transform: scaleX(1); } 100% { transform: scaleX(0); transform-origin: right; } }

  /* Page-load sequence */
  .enter { animation: enter .7s cubic-bezier(.2, .8, .2, 1) both; }
  .e1 { animation-name: pop; animation-duration: .8s; }
  .e2 { animation-delay: .12s; } .e3 { animation-delay: .22s; } .e4 { animation-delay: .32s; } .e5 { animation-delay: .42s; } .e6 { animation-delay: .5s; }
  @keyframes enter { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: none; } }
  @keyframes pop { 0% { opacity: 0; transform: scale(.6) rotate(-8deg); } 70% { opacity: 1; transform: scale(1.06) rotate(2deg); } 100% { transform: none; } }

  .screen { margin: 0; border-radius: var(--radius-lg); background: var(--frame); border: 1px solid var(--line); padding: 8px; align-self: center; }
  .screen figcaption { padding: 10px 6px 2px; font-size: 13.5px; color: #c3cfdd; }

  .what { padding-top: 24px; }
  .what-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .what-card { display: grid; gap: 12px; align-content: start; padding: 24px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); position: relative; overflow: hidden; transition: transform .25s cubic-bezier(.2, .8, .2, 1), border-color .25s; }
  .what-card::before { content: ""; position: absolute; left: 0; top: 0; height: 4px; width: 100%; background: var(--amber); transform: scaleX(0); transform-origin: left; transition: transform .4s cubic-bezier(.2, .8, .2, 1); }
  .what-card:hover { transform: translateY(-4px); border-color: var(--amber); }
  .what-card:hover::before { transform: scaleX(1); }
  .what-card h3 { font-size: 19px; }
  .what-card p { color: var(--muted); font-size: 15.5px; }
  @media (max-width: 1000px) { .what-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .what-grid { grid-template-columns: 1fr; } }

  .featured { backface-visibility: hidden; isolation: isolate; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 36px; align-items: center; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 36px; margin-bottom: 24px; border-top: 6px solid var(--amber); }
  .f-body { display: grid; gap: 18px; }
  .f-meta { display: flex; gap: 12px; align-items: center; color: var(--muted); font-size: 14px; }
  .featured h3 { font-size: clamp(26px, 3vw, 34px); font-weight: 800; letter-spacing: -0.02em; }
  /* the whole card is clickable: the title link stretches over it; the buttons stay on top with their own links */
  .featured { position: relative; cursor: pointer; }
  .featured h3 a { text-decoration: none; }
  .card-link::after { content: ""; position: absolute; inset: 0; z-index: 1; border-radius: inherit; }
  .featured .actions, .featured .actions a { position: relative; z-index: 2; }
  .featured:has(.card-link:focus-visible) { outline: 3px solid var(--amber); outline-offset: 4px; }
  .card-link:focus-visible { outline: none; }
  .featured > .f-body > p { color: var(--muted); font-size: 18px; }
  .metrics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 6px 0; }
  .metrics div { border-left: 3px solid var(--amber); padding-left: 14px; }
  .metrics dt { font-size: 32px; font-weight: 800; letter-spacing: -0.02em; }
  .metrics dd { margin: 2px 0 0; font-size: 14px; color: var(--muted); line-height: 1.4; }
  .featured .actions { margin-top: 4px; }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
  /* focus: the hovered project grows, the rest step back */
  @media (hover: hover) {
    :global(html.js) .featured, .featured {
      transition: opacity .6s ease, translate .7s cubic-bezier(.2, .8, .2, 1), scale 1s cubic-bezier(.22, 1, .36, 1), box-shadow 1s ease;
      transition-delay: var(--d, 0ms), var(--d, 0ms), 0s, 0s;
    }
    .featured:hover { scale: 1.015; box-shadow: 0 30px 60px -34px rgba(15, 30, 51, .5); }
  }

  .band { background: var(--surface); border-block: 1px solid var(--line); }
  .timeline { list-style: none; padding: 0; margin: 0; display: grid; gap: 40px; position: relative; }
  .timeline > li { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 28px; position: relative; }
  /* line that draws itself while scrolling through the section */
  .timeline::before, .timeline::after { content: ""; position: absolute; left: 193px; top: 8px; bottom: 8px; width: 2px; border-radius: 2px; }
  .timeline::before { background: var(--line); }
  .timeline::after { background: var(--amber); transform-origin: top; transform: scaleY(var(--p, 1)); }
  .timeline > li::before { content: ""; position: absolute; z-index: 1; left: 187px; top: 4px; width: 14px; height: 14px; border-radius: 50%; background: var(--surface); border: 2px solid var(--line); transition: background .3s, border-color .3s, box-shadow .3s; }
  .timeline > li.passed::before { background: var(--amber); border-color: var(--amber); box-shadow: 0 0 0 5px color-mix(in srgb, var(--amber) 25%, transparent); }
  .timeline > li > div:last-child { padding-left: 18px; }
  /* hero parallax + featured card growing in */
  .intro, .screen-wrap { will-change: transform, opacity; }
  .featured { transform: scale(calc(.94 + var(--p, 1) * .06)); transform-origin: center top; transition: scale .4s cubic-bezier(.2, .9, .3, 1.2), box-shadow .4s; }
  .featured:hover { scale: 1.015; box-shadow: 0 30px 60px -34px rgba(15, 30, 51, .5); }
  .when { color: var(--muted); font-size: 15px; padding-top: 3px; font-variant-numeric: tabular-nums; }
  .where { color: var(--navy); font-weight: 600; margin-top: 4px; }
  .points { margin: 12px 0 14px; padding-left: 20px; color: var(--muted); display: grid; gap: 6px; max-width: 72ch; }

  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; }
  .edu { list-style: none; padding: 0; margin: 0; display: grid; gap: 22px; }
  .edu li { display: grid; gap: 3px; }
  .edu p { color: var(--muted); }
  .edu span { font-size: 14px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .skills { display: grid; gap: 20px; }
  .skills h3 { font-size: 16px; margin-bottom: 8px; }

  .contact { text-align: left; }
  .contact p { color: var(--muted); margin-top: 12px; }
  .mail { display: inline-block; margin-top: 22px; font-size: clamp(24px, 4.4vw, 46px); font-weight: 800; letter-spacing: -0.02em; text-decoration: none; border-bottom: 4px solid var(--amber); overflow-wrap: anywhere; }
  .mail:hover { color: var(--navy); }

  @media (max-width: 960px) {
    /* photo and name on the same row, the rest of the text underneath */
    .hero-grid { grid-template-columns: auto minmax(0, 1fr); grid-template-areas: "pic head" "body body"; gap: 24px clamp(16px, 4vw, 32px); align-items: center; }
    .intro { display: contents; }
    .portrait { grid-area: pic; justify-items: start; }
    .head { grid-area: head; }
    .body { grid-area: body; }
    .portrait :global(.avatar) { width: clamp(96px, 26vw, 200px) !important; }
    .hero h1 { font-size: clamp(28px, 7.4vw, 56px); }
    .role { font-size: clamp(15px, 3.6vw, 19px); }
    .about { margin-top: 0; }
    .featured { grid-template-columns: 1fr; }
    .two-col { grid-template-columns: 1fr; gap: 48px; }
  }
  @media (max-width: 640px) {
    .hero { padding-top: 36px; }
    .facts { grid-template-columns: 1fr; }
    .featured { padding: 24px 20px; }
    .metrics { grid-template-columns: 1fr; }
    .timeline > li { grid-template-columns: 1fr; gap: 6px; padding-left: 28px; }
    .timeline::before, .timeline::after { left: 6px; }
    .timeline > li::before { left: 0; }
    .timeline > li > div:last-child { padding-left: 0; }
  }
</style>
